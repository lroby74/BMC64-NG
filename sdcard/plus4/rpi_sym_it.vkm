!CLEAR
!LSHIFT 1 7
!RSHIFT 1 7
!VSHIFT RSHIFT
Escape 7 7 8         /*          ESC -> Run/Stop     */
1             7 0 8   /* 1           */
2             7 3 8   /* 2           */
3             1 0 32  /* 3           */
3             0 2 16  /* £           */
4             1 3 8   /* 4           */
5             2 0 8   /* 5           */
6             2 3 8   /* 6           */
7             3 0 32  /* 7           */
7             6 7 16  /* /           */
8             3 3 8   /* 8           */
9             4 0 8   /* 9           */
0             4 3 32  /* 0           */
0             6 5 16  /* =           */
Dash          3 0 33  /* '           */
Dash          6 7 1   /* ?           */
Equals        4 3 33  /* ^           (scelta) */
Equals        6 4 1   /* Pi          (scelta) */
Pound 6 5 32         /*            = -> =            */
Pound 6 6 16         /*            + -> +            */
BackSpace 0 0 8      /*    Backspace -> DEL          */
Control_L     7 5 8192   /*        Cntrl -> CBM          */
q 7 6 8              /*            Q -> Q            */
w 1 1 8              /*            W -> W            */
e 1 6 8              /*            E -> E            */
r 2 1 8              /*            R -> R            */
t 2 6 8              /*            T -> T            */
y 3 1 8              /*            Y -> Y            */
u 3 6 8              /*            U -> U            */
i 4 1 8              /*            I -> I            */
o 4 6 8              /*            O -> O            */
p 5 1 8              /*            P -> P            */
LeftBracket   5 5 33  /* [           (scelta) */
LeftBracket   6 2 1   /* ]           (scelta) */
RightBracket  6 6 32  /* +           */
RightBracket  6 1 16  /* *           */
Return 0 1 8         /*       Return -> Return       */
Tab           7 2 16384  /*          Tab -> Ctrl         */
a 1 2 8              /*            A -> A            */
s 1 5 8              /*            S -> S            */
d 2 2 8              /*            D -> D            */
f 2 5 8              /*            F -> F            */
g 3 2 8              /*            G -> G            */
h 3 5 8              /*            H -> H            */
j 4 2 8              /*            J -> J            */
k 4 5 8              /*            K -> K            */
l 5 2 8              /*            L -> L            */
SemiColon     0 7 32  /* @           (scelta) */
SemiColon     5 5 16  /* :           (scelta) */
SingleQuote   1 0 33  /* #           (scelta) */
SingleQuote   7 3 1   /* "           (scelta) */
BackSlash     6 4 8   /* Freccia sx  (scelta) */
Shift_L 1 7 2        /*   Left Shift -> Left Shift   */
CapsLock 1 7 64      /*    Caps Lock -> Shift Lock   */
z 1 4 8              /*            Z -> Z            */
x 2 7 8              /*            X -> X            */
c 2 4 8              /*            C -> C            */
v 3 7 8              /*            V -> V            */
b 3 4 8              /*            B -> B            */
n 4 7 8              /*            N -> N            */
m 4 4 8              /*            M -> M            */
Comma         5 7 32  /* ,           */
Comma         6 2 16  /* ;           */
Period        5 4 32  /* .           */
Period        5 5 16  /* :           */
Slash         5 6 8   /* -           */
Shift_R 1 7 4        /*  Right Shift -> Right Shift  */
Space 7 4 8          /*        Space -> Space        */
F1 0 4 8             /*  F1 -> F1  GRAPHIC   */
F2 0 5 8             /*  F2 -> F2  DLOAD"    */
F3 0 6 8             /*  F3 -> F3  DIRECTORY */
F4 0 4 1             /*  F4 -> F4  SCNCLR    */
F5 0 5 1             /*  F5 -> F5  DSAVE"    */
F6 0 6 1             /*  F6 -> F6  RUN       */
F7 0 3 1             /*  F7 -> F7  LIST      */
F8 0 3 8             /*  F8 -> HELP          */
Home 7 1 8           /*         Home -> CLR/HOME     */
Up 5 3 8             /*           Up -> CRSR UP      */
Down 5 0 8           /*         Down -> CRSR DOWN    */
Insert 0 0 1         /*       Insert -> INS          */
Del 0 0 8            /*       Delete -> DEL          */
Left 6 0 8           /*         Left -> Left         */
Right 6 3 8          /*         Right -> Right       */
PrintScreen -3 0
NonUSBackSlash 5 7 33 /* <           (tasto ISO) */
NonUSBackSlash 5 4 1  /* >           (tasto ISO) */
