!CLEAR
!LSHIFT 1 7
!RSHIFT 6 4
!VSHIFT RSHIFT
!SHIFTL LSHIFT
!LCBM 7 5
!VCBM LCBM
!LCTRL 7 2
!VCTRL LCTRL
Escape 7 7 8             /*          ESC -> Run/Stop     */
1 7 0 8              /*            1 -> 1            */
2 7 3 32             /*            2 -> 2            */
2 5 6 16             /*            @ -> @            */
3 1 0 8              /*            3 -> 3            */
4 1 3 8              /*            4 -> 4            */
5 2 0 8              /*            5 -> 5            */
6 2 3 32             /*            6 -> 6            */
6 6 6 16             /*            ^ -> ^            */
7 3 0 32             /*            7 -> 7            */
7 2 3 1              /*            & -> &            */
8 3 3 32             /*            8 -> 8            */
8 6 1 16             /*            * -> *            */
9 4 0 32             /*            9 -> 9            */
9 3 3 1              /*            ( -> (            */
0 4 3 32             /*            0 -> 0            */
0 4 0 1              /*            ) -> )            */
Dash 5 3 8           /*        Minus -> Minus        */
Equals 6 5 32        /*            = -> =            */
Equals 5 0 16        /*            + -> +            */
Pound 6 5 32         /*            = -> =            */
Pound 5 0 16         /*            + -> +            */
BackSpace 0 0 8      /*    Backspace -> DEL          */
Control_L     7 5 8192   /*        Cntrl -> CBM          */
q 7 6 8              /*            Q -> Q            */
w 1 1 8              /*            W -> W            */
e 1 6 8              /*            E -> E            */
r 2 1 8              /*            R -> R            */
t 2 6 8              /*            T -> T            */
y 3 1 8              /*            Y -> Y            */
u 3 6 8              /*            U -> U            */
i 4 1 8              /*            I -> I            */
o 4 6 8              /*            O -> O            */
p 5 1 8              /*            P -> P            */
LeftBracket 5 5 1    /*            [ -> [            */
RightBracket 6 2 1   /*            ] -> ]            */
Return 0 1 8         /*       Return -> Return       */
Tab           7 2 16384  /*          Tab -> Ctrl         */
a 1 2 8              /*            A -> A            */
s 1 5 8              /*            S -> S            */
d 2 2 8              /*            D -> D            */
f 2 5 8              /*            F -> F            */
g 3 2 8              /*            G -> G            */
h 3 5 8              /*            H -> H            */
j 4 2 8              /*            J -> J            */
k 4 5 8              /*            K -> K            */
l 5 2 8              /*            L -> L            */
SemiColon 6 2 32     /*            ; -> ;            */
SemiColon 5 5 16     /*            : -> :            */
SingleQuote 3 0 33   /*            ' -> '            */
SingleQuote 7 3 1    /*            " -> "            */
BackQuote 7 1 32     /*            ` -> Left Arrow   */
BackQuote 6 6 1      /*            ~ -> Pi           */
BackSlash 6 0 8      /*            \ -> Lira         */
Shift_L 1 7 2        /*   Left Shift -> Left Shift   */
CapsLock 1 7 64      /*    Caps Lock -> Shift Lock   */
z 1 4 8              /*            Z -> Z            */
x 2 7 8              /*            X -> X            */
c 2 4 8              /*            C -> C            */
v 3 7 8              /*            V -> V            */
b 3 4 8              /*            B -> B            */
n 4 7 8              /*            N -> N            */
m 4 4 8              /*            M -> M            */
Comma 5 7 8          /*            , -> ,            */
Period 5 4 8         /*            . -> .            */
Slash 6 7 8          /*            / -> /            */
Shift_R 6 4 4        /*  Right Shift -> Right Shift  */
Space 7 4 8          /*        Space -> Space        */
F1 0 4 8             /*           F1 -> F1           */
F2 0 4 1             /*           F2 -> F2           */
F3 0 5 8             /*           F3 -> F3           */
F4 0 5 1             /*           F4 -> F4           */
F5 0 6 8             /*           F5 -> F5           */
F6 0 6 1             /*           F6 -> F6           */
F7 0 3 8             /*           F7 -> F7           */
F8 0 3 1             /*           F8 -> F8           */
Home 6 3 8           /*         Home -> CLR/HOME     */
Up 0 7 1             /*           Up -> CRSR UP      */
Down 0 7 8           /*         Down -> CRSR DOWN    */
Insert 0 0 1         /*       Insert -> INS          */
Del 0 0 8            /*       Delete -> DEL          */
Left 0 2 1           /*         Left -> Left         */
Right 0 2 8          /*         Right -> Right       */
PrintScreen -3 0

# --- IL TASTIERINO NUMERICO DEL C128 ------------------------------------
# Righe 8, 9 e 10 della matrice: caselle che il C64 non ha e che in BMC64
# non erano mai state portate. Copiate dalla posizionale del VICE
# ufficiale (data/C128/sdl_pos.vkm).
# Il + da' + e il - da' -: il VICE ufficiale li scambia per tenere la
# POSIZIONE (sul C128 il + sta a destra del 9, sul PC c'e' il -); noi
# teniamo il SIMBOLO, che e' quello che si legge sul copritasto.
# Il / e il * del tastierino del PC restano liberi: sul C128 non ci sono.
KP_0          10 1 8   /* 0 */
KP_1           8 7 8   /* 1 */
KP_2           8 4 8   /* 2 */
KP_3           9 7 8   /* 3 */
KP_4           8 5 8   /* 4 */
KP_5           8 2 8   /* 5 */
KP_6           9 5 8   /* 6 */
KP_7           8 6 8   /* 7 */
KP_8           8 1 8   /* 8 */
KP_9           9 6 8   /* 9 */
KP_Decimal    10 2 8   /* punto */
KP_Enter       9 4 8   /* INVIO */
KP_Add         9 1 8   /* +   (per SIMBOLO: il VICE ufficiale qui mette il -) */
KP_Subtract    9 2 8   /* -   (per SIMBOLO: il VICE ufficiale qui mette il +) */

# --- GLI OTTO TASTI IN PIU' DEL C128, SU ALT + F1..F8 -------------------
# Questi nomi non stanno su nessun tasto del PC: sono codici finti che
# kbd.c manda quando si preme ALT + un tasto funzione. Un file di mappa
# non sa dire "questo tasto CON ALT", quindi la combinazione la riconosce
# il codice e la TRADUZIONE resta qui, dove si corregge senza
# ricompilare. L'ordine e' quello dei tasti sulla macchina vera.
C128_ESC       9 0 8   /* ESC          ALT+F1 */
C128_TAB       8 3 8   /* TAB          ALT+F2 */
C128_ALT      10 0 8   /* ALT          ALT+F3 */
C128_CAPS     -4 1     /* CAPS LOCK    ALT+F4  (ASCII/DIN) */
C128_HELP      8 0 8   /* HELP         ALT+F5 */
C128_LINEFEED  9 3 8   /* LINE FEED    ALT+F6 */
C128_NOSCROLL 10 7 0   /* NO SCROLL    ALT+F8  (bandiera 0 come a monte) */
